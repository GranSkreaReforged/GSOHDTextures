<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unity 2017.4 legacy Mono runtime: .NET 3.5 profile. -->
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>GSOHDTextures</AssemblyName>
    <RootNamespace>GSOHDTextures</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <!--
      Every build is laid out as it goes into the game folder, for review or a manual install (see
      INSTALL.txt there). Building never writes to the game; build.ps1 -Deploy copies this in.
      Kept in sync with Get-StageDir in build\GSOBuild.psm1.
    -->
    <StageDir>$(MSBuildThisFileDirectory)..\..\artifacts\build\$(Configuration)\</StageDir>
    <StagePluginDir>$(StageDir)BepInEx\plugins\$(AssemblyName)\</StagePluginDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(BepInExCore)BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(BepInExCore)0Harmony.dll" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(ManagedDir)Assembly-CSharp.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ManagedDir)UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ManagedDir)UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(ManagedDir)UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ManagedDir)UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="UnityEngine.InputModule" HintPath="$(ManagedDir)UnityEngine.InputModule.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ManagedDir)UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ManagedDir)UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(ManagedDir)UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="UnityEngine.TerrainModule" HintPath="$(ManagedDir)UnityEngine.TerrainModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)UnityEngine.CoreModule.dll')"
           Text="Gran Skrea Online not found at '$(GameDir)'. Run build.ps1 (auto-detects Steam libraries), pass -p:GameDir=..., or set GSO_GAME_DIR." />
    <Error Condition="!Exists('$(BepInExCore)BepInEx.dll')"
           Text="BepInEx reference DLLs not found at '$(BepInExCore)'. Run build.ps1 once; it unpacks the pinned BepInEx into .cache\bepinex-ref (nothing is installed in the game)." />
  </Target>

  <!-- Exposes the MSBuild version to the [BepInPlugin] attribute, which needs a compile-time constant. -->
  <Target Name="GeneratePluginInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <PluginInfoFile>$(IntermediateOutputPath)PluginInfo.g.cs</PluginInfoFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(PluginInfoFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="namespace GSOHDTextures { internal static class PluginInfo { public const string Version = &quot;$(Version)&quot;%3B public const string BuildVersion = &quot;$(InformationalVersion)&quot;%3B public const bool ReleaseBuild = $(ReleaseBuild)%3B } }" />
    <ItemGroup>
      <Compile Include="$(PluginInfoFile)" />
      <FileWrites Include="$(PluginInfoFile)" />
    </ItemGroup>
  </Target>

  <Target Name="StagePlugin" AfterTargets="Build">
    <MakeDir Directories="$(StagePluginDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StagePluginDir)" />
    <Message Importance="high" Text="Built $(TargetFileName) $(InformationalVersion) -> $([System.IO.Path]::GetFullPath('$(StagePluginDir)'))" />
  </Target>

</Project>
